<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.13</version>
    <relativePath/>
  </parent>

  <groupId>com.ruankao</groupId>
  <artifactId>ruankao-server</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>ruankao-server</name>
  <description>软考在线学习平台 · 后端（Maven 多模块单体）</description>

  <!--
    依赖方向严格单向（06 §6.1 / 03 §3.3.1）：
      rk-boot -> rk-api -> rk-service -> rk-repository -> rk-domain -> rk-common
    该约束由各模块自己的 maven-enforcer-plugin 在构建期强制，见各子模块 pom 的
    enforce-layering 执行。此处只定义版本与共性规则，不下发任何依赖。
  -->
  <modules>
    <module>rk-common</module>
    <module>rk-domain</module>
    <module>rk-repository</module>
    <module>rk-service</module>
    <module>rk-api</module>
    <module>rk-boot</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- 版本集中管理。与 03 §3.2 技术栈表保持一致；升级需同步该表。 -->
    <mybatis-plus.version>3.5.17</mybatis-plus.version>
    <sa-token.version>1.39.0</sa-token.version>
    <knife4j.version>4.5.0</knife4j.version>
    <hutool.version>5.8.47</hutool.version>
    <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>

    <!-- 本地启动默认端口。部署时由环境变量 RK_SERVER_PORT 覆盖。 -->
    <rk.server.port>8080</rk.server.port>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- 本项目模块 -->
      <dependency>
        <groupId>com.ruankao</groupId>
        <artifactId>rk-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ruankao</groupId>
        <artifactId>rk-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ruankao</groupId>
        <artifactId>rk-repository</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ruankao</groupId>
        <artifactId>rk-service</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ruankao</groupId>
        <artifactId>rk-api</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- 第三方：mysql-connector-j、spring-boot-starter-*、spring-context/spring-tx、
           jakarta.validation-api 等由 spring-boot-dependencies 托管版本，故不在此重复声明。 -->
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.dev33</groupId>
        <artifactId>sa-token-spring-boot3-starter</artifactId>
        <version>${sa-token.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.dev33</groupId>
        <artifactId>sa-token-redis-jackson</artifactId>
        <version>${sa-token.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.xiaoymin</groupId>
        <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        <version>${knife4j.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.hutool</groupId>
        <artifactId>hutool-all</artifactId>
        <version>${hutool.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <!-- 显式声明注解处理器路径，而不是靠 classpath 上的隐式发现：
                 JDK 21 已对隐式注解处理发告警，后续版本会默认关闭，
                 届时 Lombok 会静默失效（表现为满屏"找不到 getter"）。 -->
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- 共性规则：所有模块都必须满足。模块特有的分层禁令在各自 pom 里另加执行。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-baseline</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                  <message>本项目要求 JDK 21+（03 §3.2 技术栈表）。当前 JAVA_HOME 指向的版本过低。</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                  <message>本项目要求 Maven 3.9+。</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
