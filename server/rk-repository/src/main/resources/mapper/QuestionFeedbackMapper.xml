<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruankao.repository.mapper.QuestionFeedbackMapper">

    <!--
      只插入"提交即确定"的列：question_id / user_id / type / content / status。
      handler_id、handle_remark、handled_at 是处理环节才写，新增时保持 NULL（DDL 可空），
      故不在此列出——SQL 里没有这些列，也就杜绝了"提交时误填处理人"的可能。
      created_at 交给 DDL 默认值（时钟以库为准）。
    -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO rk_question_feedback
            (question_id, user_id, type, content, status)
        VALUES
            (#{questionId}, #{userId}, #{type}, #{content}, #{status})
    </insert>

</mapper>