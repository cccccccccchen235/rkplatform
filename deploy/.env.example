# ===============================================================
# 环境变量模板 —— 本地开发用（09 §9.4）
#
# 用法：cp deploy/.env.example deploy/.env，然后按注释补空值。
# 真正的 deploy/.env 已在仓库根 .gitignore 中（09 §9.4.2），**绝不提交**。
#
# 注意区分两类变量：
#   · 应用级：后端启动时由 RequiredEnvValidator 校验非空（约束 AC-1），
#     **必填清单的唯一出处是该类，本文件不重复维护**；
#   · 容器级：只有 compose（mysql / redis 容器）与 docker run 用得到，
#     后端自身不读（MYSQL_ROOT_PASSWORD / TZ / JAVA_OPTS）。
#
# 口令类变量一律留空，请自行填写；**生产必须按 09 §9.4.1 用 openssl rand 重新生成**，
# 不要照抄本文件的任何示例值。
# ===============================================================

# ---------------- MySQL ----------------
# 容器级：仅 mysql 容器初始化与备份脚本使用，不进后端。
# 留空则 compose 回落到它内置的本地默认值（09 §9.3.2），本地开发可不动它；生产必须填。
MYSQL_ROOT_PASSWORD=
# 应用级：库名（04 文档固定 ruankao，utf8mb4）
MYSQL_DATABASE=ruankao
# 应用级：业务库账号；本地直连时用 root 亦可，生产必须用受限账号
MYSQL_USERNAME=ruankao
# 应用级：业务库账号口令 —— 【必填】本地填 mysql 容器的 MYSQL_PASSWORD
MYSQL_PASSWORD=

# ---------------- Redis ----------------
# 应用级：本地直连 127.0.0.1；compose 内为服务名 redis
REDIS_HOST=127.0.0.1
# 应用级
REDIS_PORT=6379
# 应用级：Redis 口令（--requirepass）——【必填】
REDIS_PASSWORD=

# ---------------- 后端应用 ----------------
# 应用级：登录态有效期（秒），默认 30 天。Sa-Token 用不透明 UUID 令牌、会话存 Redis，
# 因此不存在需要轮换的令牌签名密钥，强制下线靠删除会话（06 §6.5）——【必填】
RK_TOKEN_TIMEOUT=
# 应用级：后端端口（容器内；本地即宿主端口）
RK_SERVER_PORT=8080
# 管理端点端口（容器内，不对外映射），承载 /actuator/health
RK_MGMT_PORT=8081
# 应用级：日志级别，故障期临时调 debug
RK_LOG_LEVEL=info
# 日志目录（容器内），对应宿主 deploy/data/logs
RK_LOG_DIR=/app/logs
# 应用级：图片存储目录（05 §5.10-51）——本地填本机绝对路径，如 D:/data/uploads ——【必填】
RK_UPLOAD_DIR=
# 允许的跨域来源，逗号分隔；同源部署留空即关闭 CORS
RK_CORS_ORIGINS=
# Knife4j（/doc.html）开关，**生产必须 false**；本地要看文档改成 true
RK_DOC_ENABLED=false
# 管理端点开关；仅绑内部 RK_MGMT_PORT，公网不可达
RK_ACTUATOR_ENABLED=true

# ---------------- 容器与 JVM ----------------
# 容器级：所有容器时区，影响日志时间与 MySQL NOW()
TZ=Asia/Shanghai
# 容器级：JVM 参数，-Xmx 与 03 文档 §3.7 一致
JAVA_OPTS=-Xmx1024m -Xms512m -XX:+UseG1GC -XX:MaxMetaspaceSize=256m

# ---------------- 镜像与发布 ----------------
# 镜像仓库前缀（CI 推送与 compose pull 使用）
REGISTRY=ghcr.io/your-org
# 镜像标签，回滚时改回上一个 sha
IMAGE_TAG=latest
